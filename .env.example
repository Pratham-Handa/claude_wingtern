# Required: Anthropic API key (server-side only, never exposed to the browser)
ANTHROPIC_API_KEY=

# Required in production: access password(s) for the whole site.
# Comma-separate several to give different people different passwords.
LENS_PASSWORD=

# Optional but recommended: random secret for signing sessions (e.g. `openssl rand -hex 32`).
# With it set, removing one password only logs out that password's sessions;
# without it, any change to LENS_PASSWORD logs everyone out.
# Set it if you leave LENS_PASSWORD empty too: otherwise bring-your-own-key page sessions
# are signed with a public default and could be forged (this grants page access only, never the server's key).
# LENS_AUTH_SECRET=

# Optional: model overrides (PRD §8.2 latency escape hatch)
# LENS_CARD_MODEL=claude-sonnet-5-5
# LENS_SCENE_MODEL=claude-opus-5-5
# LENS_CINEMATIC_MODEL=claude-opus-5-5
